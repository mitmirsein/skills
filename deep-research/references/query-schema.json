{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Deep Research Query",
  "type": "object",
  "required": ["topic", "question", "audience", "depth", "deliverables"],
  "properties": {
    "topic": {
      "type": "string",
      "minLength": 1
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "audience": {
      "type": "string"
    },
    "depth": {
      "enum": ["brief", "standard", "comprehensive"]
    },
    "strict": {
      "type": "boolean",
      "default": false
    },
    "scope": {
      "type": "object",
      "properties": {
        "timeframe": {
          "type": "string"
        },
        "geography": {
          "type": "string"
        },
        "included": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "excluded": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "source_preferences": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "deliverables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "executive_summary",
          "full_report",
          "bibliography",
          "claim_ledger",
          "comparison_data"
        ]
      }
    },
    "language": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
